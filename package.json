{
  "name": "inventra-erp-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "npm run check && tsc -p tsconfig.server-build.json && vite build",
    "start:api": "node dist-server/index.js",
    "check": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:seed": "tsx server/src/seed.ts",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate --schema=prisma/schema.postgresql.prisma && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}